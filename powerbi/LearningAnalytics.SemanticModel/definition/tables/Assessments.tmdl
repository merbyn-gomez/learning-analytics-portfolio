table Assessments

	column assessment_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: assessment_id

	column enrollment_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: enrollment_id

	column score
		dataType: int64
		summarizeBy: none
		sourceColumn: score

	partition Assessments = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/merbyn-gomez/learning-analytics-portfolio/main/powerbi/sample-data/assessments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"assessment_id", Int64.Type}, {"enrollment_id", Int64.Type}, {"score", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
